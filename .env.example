# --- Database (Neon) -------------------------------------------------------
# App runtime: pooled connection (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/fedflow?sslmode=require"
# Migrations and ingestion jobs: direct (unpooled) connection. Required for advisory locks.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/fedflow?sslmode=require"
# Integration tests: a disposable, migrated database. Tests TRUNCATE its tables.
# TEST_DATABASE_URL="postgresql://fedflow:fedflow@localhost:5432/fedflow_test"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Ticker mapping (Phase 2) ------------------------------------------------
# SEC requires a User-Agent naming the app and a contact email.
SEC_USER_AGENT="FedFlow you@yourdomain.com"
# SAM.gov public API key (optional). Without it, USAspending's parent UEIs are used alone.
SAM_API_KEY=""
# Max SAM requests per 24h (default keys allow ~10/day; entity-role keys ~1,000/day).
SAM_DAILY_LIMIT="900"

# --- Stock prices (Phase 3) --------------------------------------------------
# Unset = no price chart (award charts still show). "mock" = SIMULATED prices for local
# development only; ignored when NODE_ENV=production. Licensed vendors plug in via
# src/lib/market-data/index.ts.
MARKET_DATA_PROVIDER=""
MARKET_DATA_API_KEY=""

# --- Auth (Phase 4) -----------------------------------------------------------
# Random 32+ byte secret: `openssl rand -base64 32`
AUTH_SECRET=""
# Public base URL (also used for Stripe return URLs via NEXT_PUBLIC_APP_URL)
AUTH_URL="http://localhost:3000"
# Google OAuth client (optional; Google sign-in is hidden when unset).
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Magic-link and alert email. Without RESEND_API_KEY in development, links print to the server console.
RESEND_API_KEY=""
EMAIL_FROM="FedFlow <no-reply@yourdomain.com>"
# Comma-separated emails that get the ADMIN role (ticker review, ingestion runs) on sign-in.
ADMIN_EMAILS=""

# --- Billing (Phase 4) -----------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs referenced by src/config/plans.ts (stripePriceIdEnv)
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
# Old price IDs still used by existing subscribers after a price change (comma-separated)
STRIPE_PRICE_PRO_LEGACY=""

# --- Error monitoring (Phase 7, optional) --------------------------------------
# Sentry is off unless a DSN is set. Server/edge and ingestion jobs read SENTRY_DSN; the
# browser reads NEXT_PUBLIC_SENTRY_DSN (usually the same value). User emails, cookies and
# auth tokens are scrubbed before sending (src/lib/monitoring/scrub.ts).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.05"
# Build-time only, for readable stack traces (source map upload). Leave empty locally.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- End-to-end tests (Phase 7) ----------------------------------------------------
# Playwright resets this database on every run. Default shown.
# E2E_DATABASE_URL="postgresql://fedflow:fedflow@localhost:5432/fedflow_e2e"
# Use a preinstalled Chromium instead of `playwright install`.
# PW_CHROMIUM_PATH=""
